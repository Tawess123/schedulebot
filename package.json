{
  "name": "schedulebot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord schedule bot with a web control panel",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "schedule"
  ],
  "license": "MIT",

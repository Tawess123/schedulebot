    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ID of the channel the bot posts the schedule to
CHANNEL_ID=

# ID of the role allowed to pause / resume the schedule
PAUSE_ROLE_ID=

# Port the web panel listens on
WEB_PORT=3000

# Shared secret required to authenticate against the web panel API.
# Also signs the personal /horaire links, so changing it invalidates them.
WEB_SECRET=

# Public address of the panel, used to build the /horaire links.
# Defaults to http://localhost:WEB_PORT — set it once you have a domain.
PUBLIC_URL=
